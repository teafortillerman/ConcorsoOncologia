{
  "id": "net",
  "title": "NET",
  "theme": "Gastrointestinali",
  "scheda": "Schede/Gastrointestinali/NET.md",
  "exposures": {
    "ssa": "Analogo della somatostatina",
    "prrt": "PRRT",
    "captem": "CAPTEM",
    "everolimus": "Everolimus"
  },
  "start": "setting",
  "nodes": {
    "setting": {
      "type": "question",
      "text": "NET ben differenziato o NEC?",
      "short": "Differenziazione",
      "info": "WHO 2022: NET G3 e NEC possono avere lo stesso Ki-67 >20% ma comportamento e risposta al platino diversi. 68Ga-SST PET/TC standard of care (sensibilità 97%).",
      "answers": [
        {
          "label": "NET ben differenziato (G1-G3)",
          "next": "net_setting"
        },
        {
          "label": "NEC scarsamente differenziato",
          "next": "nec_1l"
        }
      ]
    },
    "net_setting": {
      "type": "question",
      "text": "Qual è il setting?",
      "short": "Setting",
      "answers": [
        {
          "label": "Localizzato resecabile",
          "next": "net_loc_sede"
        },
        {
          "label": "Avanzato / metastatico",
          "next": "net_adv_sede"
        }
      ]
    },
    "net_loc_sede": {
      "type": "question",
      "text": "Qual è la sede del primitivo?",
      "short": "Sede",
      "answers": [
        {
          "label": "Pancreas",
          "next": "loc_pan"
        },
        {
          "label": "Piccolo intestino",
          "next": "loc_ileo"
        },
        {
          "label": "Appendice",
          "next": "loc_app"
        },
        {
          "label": "Retto",
          "next": "loc_retto"
        },
        {
          "label": "Stomaco",
          "next": "loc_stomaco"
        },
        {
          "label": "Duodeno",
          "next": "loc_duod"
        }
      ]
    },
    "loc_pan": {
      "type": "recommendation",
      "title": "Chirurgia",
      "options": [
        {
          "name": "Enucleazione se <2 cm G1-2",
          "aifa": "standard",
          "key": "Preserva la funzione pancreatica, con più rischio di fistola."
        },
        {
          "name": "Resezione formale se >2 cm o funzionante",
          "aifa": "standard",
          "key": "Raccomandazione forte: OS a 5 anni 86,6% vs 40,1% senza chirurgia. Insulinoma: guarigione ~93%."
        },
        {
          "name": "Follow-up nel MEN1 con PanNET non funzionante <2 cm",
          "aifa": "standard",
          "key": "Crescita molto lenta (0,4 mm/anno)."
        }
      ],
      "note": "Rischio di malignità dei non funzionanti: 19% (≤2 cm), 35% (2-4 cm), 85% (>4 cm)."
    },
    "loc_ileo": {
      "type": "recommendation",
      "title": "Chirurgia",
      "options": [
        {
          "name": "Resezione del primitivo con linfoadenectomia mesenterica",
          "aifa": "standard",
          "key": "Anche con metastasi non resecabili (UKINETS: OS 9,9 vs 4,7 anni). Multifocalità nel 40%."
        }
      ]
    },
    "loc_app": {
      "type": "recommendation",
      "title": "Chirurgia",
      "options": [
        {
          "name": "Appendicectomia semplice se <2 cm, basso grado, R0",
          "aifa": "standard",
          "key": "Nei 1-2 cm l'emicolectomia non è necessaria (Nesti 2023, ENETS 2023)."
        },
        {
          "name": "Emicolectomia destra se >2 cm",
          "aifa": "standard",
          "key": "Nei 1-2 cm solo se G2 con Ki-67 >10%, linfonodi positivi o R1/R2."
        }
      ]
    },
    "loc_retto": {
      "type": "recommendation",
      "title": "Trattamento locale",
      "options": [
        {
          "name": "ESD o m-EMR",
          "aifa": "standard",
          "key": "Preferite alla polipectomia semplice; la dimensione è il fattore prognostico dominante (cut-off 5 mm, lesioni <16 mm)."
        }
      ]
    },
    "loc_stomaco": {
      "type": "recommendation",
      "title": "Trattamento per tipo",
      "options": [
        {
          "name": "Tipo I: sorveglianza endoscopica",
          "aifa": "standard",
          "key": "70-80%, da gastrite atrofica; metastasi <2%. SSA se ricorrente."
        },
        {
          "name": "Tipo II: PPI ad alte dosi, resezione del gastrinoma",
          "aifa": "standard",
          "key": "ZES in MEN1; metastasi linfonodali nel 30%."
        },
        {
          "name": "Tipo III: gastrectomia + linfoadenectomia",
          "aifa": "standard",
          "key": "Sporadico e aggressivo (metastasi 50-100%); EMR solo se G1 ≤10 mm."
        }
      ]
    },
    "loc_duod": {
      "type": "recommendation",
      "title": "Trattamento locale",
      "options": [
        {
          "name": "Resezione endoscopica se <1 cm",
          "aifa": "standard",
          "key": "Il grading guida il rischio di recidiva più della procedura."
        },
        {
          "name": "DCP se >2 cm",
          "aifa": "standard",
          "key": "Nella fascia 1-2 cm decidere su grading e invasione."
        }
      ]
    },
    "net_adv_sede": {
      "type": "question",
      "text": "Qual è il primitivo e il comportamento?",
      "short": "Primitivo",
      "info": "Sindrome da carcinoide: SSA; telotristat per la diarrea refrattaria. FDG-PET positiva = prognosi peggiore (HR 10,3).",
      "answers": [
        {
          "label": "GEP-NET G1-G2, SSTR+, lentamente progressivo",
          "next": "adv_ssa"
        },
        {
          "label": "GEP-NET G2 Ki-67 ≥10% o G3 ben differenziato",
          "next": "adv_alto"
        },
        {
          "label": "PanNET sintomatico / voluminoso",
          "next": "adv_pan_ct"
        }
      ]
    },
