      "options": [
        {
          "name": "Pembrolizumab + platino-paclitaxel ± bevacizumab",
          "aifa": "reimbursed",
          "key": "Rimborsato dal 10/07/2023 con CPS ≥1.",
          "regimen": {
            "trial": "KEYNOTE-826",
            "endpoint": "PFS 10,4 vs 8,2 mesi (HR 0,62); OS 24,4 vs 16,5 mesi (HR 0,64)",
            "rows": [
              ["Pembrolizumab", "200 mg EV ogni 3 settimane (fino a 35 cicli)"],
              ["Cisplatino o carboplatino", "50 mg/m² o AUC 5"],
              ["Paclitaxel", "175 mg/m² ogni 3 settimane"],
              ["± Bevacizumab", "15 mg/kg ogni 3 settimane"]
            ],
            "sources": [{"type": "rimborsabilita"}]
          }
        }
      ],
      "note": "Cadonilimab (COMPASSION-16) approvato solo in Cina.",
      "next": { "label": "Alla progressione → 2ª linea", "node": "adv_2l" }
