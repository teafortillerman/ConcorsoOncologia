        {
          "name": "Chemioterapia adiuvante (+ CT-RT se pN2 o R1-R2)",
          "aifa": "standard",
          "key": "Platino-etoposide per 4 cicli.",
          "regimen": {
            "rows": [
              [
                "Cisplatino",
                "60-80 mg/m² EV giorno 1"
              ],
              [
                "Etoposide",
                "100-120 mg/m² EV giorni 1-3"
              ],
              [
                "oppure carboplatino",
                "AUC 5 EV giorno 1 (se cisplatino controindicato)"
              ]
            ],
            "note": "Ogni 21 giorni ×4 cicli.",
            "sources": [
              {
                "type": "scheda"
              }
            ]
          }
        },
        {
          "name": "PCI",
          "aifa": "standard",
          "key": "Da discutere; negli stadi I-II l'alternativa è la sorveglianza con RM encefalo.",
          "regimen": {
            "rows": [
              [
                "Radioterapia encefalica profilattica",
                "25 Gy in 10 frazioni"
              ]
            ],
            "sources": [
              {
                "type": "scheda"
              }
            ]
          }
        }
      ],
      "next": {
        "label": "Alla recidiva o progressione → 2ª linea",
        "node": "sclc_tfi"
      }
    },
