          "regimen": {
            "trial": "ADRIATIC",
            "endpoint": "OS 55,9 vs 33,4 mesi (HR 0,73); PFS 16,6 vs 9,2 mesi (HR 0,76)",
            "rows": [
              [
                "Durvalumab",
                "1500 mg EV ogni 4 settimane (20 mg/kg se <30 kg)"
              ]
            ],
            "note": "Per un massimo di 24 mesi.",
            "sources": [
