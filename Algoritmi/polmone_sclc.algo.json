                "type": "rimborsabilita"
              }
            ]
          }
        },
        {
          "name": "PCI",
          "aifa": "standard",
          "key": "In aggiunta al durvalumab, se PS 0-1 e risposta alla CT-RT: metastasi encefaliche HR 0,45, OS HR 0,81.",
          "regimen": {
            "rows": [
              [
                "Radioterapia encefalica profilattica",
                "25 Gy in 10 frazioni"
              ]
