    "setting": {
      "type": "question",
      "text": "Qual è lo stadio (VALG/IASLC)?",
      "short": "Stadio",
      "info": "Limitato = un emitorace + linfonodi regionali, comprendibile in un unico campo di RT; esteso = metastasi a distanza. PD-L1 e bTMB non sono predittivi nel SCLC.",
      "answers": [
        {
          "label": "Stadio limitato (LD)",
          "next": "ld_estensione"
        },
        {
          "label": "Stadio esteso (ED)",
          "next": "ed_io"
        },
        {
          "label": "Recidiva o progressione dopo la 1ª linea",
          "next": "sclc_tfi"
        }
      ]
    },
    "ld_estensione": {
      "type": "question",
      "text": "Qual è l'estensione della malattia limitata?",
      "short": "Estensione",
      "info": "Chirurgia solo cT1-2N0 (~5% dei casi) dopo stadiazione mediastinica invasiva negativa; resezione sublobare non raccomandata.",
      "answers": [
        {
          "label": "cT1-2 N0 (mediastino negativo)",
          "next": "ld_chir"
        },
        {
          "label": "Stadio I-III con N+ o non operabile",
          "next": "ld_ps"
        }
      ]
    },
