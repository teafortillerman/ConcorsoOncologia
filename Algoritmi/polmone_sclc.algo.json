    "ld_ctrt": {
      "type": "recommendation",
      "title": "Chemioradioterapia",
      "options": [
        {
          "name": "CT-RT concomitante",
          "aifa": "standard",
          "key": "RT dal 1°-2° ciclo; volume sul residuo post-CT. Iperfrazionato BID: OS a 5 anni 26% vs 16% (Turrisi).",
          "regimen": {
            "rows": [
              [
                "Cisplatino",
                "60-80 mg/m² EV giorno 1"
              ],
              [
                "Etoposide",
                "100-120 mg/m² EV giorni 1-3"
              ],
              [
                "oppure carboplatino",
                "AUC 5 EV giorno 1 (se cisplatino controindicato)"
              ],
              [
                "Radioterapia",
                "45 Gy in 30 frazioni, 1,5 Gy ×2/die (oppure 66 Gy in 33 frazioni)"
              ]
            ],
            "note": "Ogni 21 giorni ×4 cicli, senza riduzioni di dose nei primi 2.",
            "sources": [
              {
                "type": "scheda"
              }
            ]
          },
          "gives": [
            "platino"
          ]
